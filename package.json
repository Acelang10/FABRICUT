{
  "name": "fabricut",
  "version": "1.0.0",
  "description": "J.C.M. Tailoring Inventory Management System",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:legacy": "node --test server/staffPolicy.test.js server/auth.http.test.js",
    "rules:staff": "node server/generateStaffRules.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.15",
    "next": "^16.4.5",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
