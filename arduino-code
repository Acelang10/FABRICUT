// Protocol v3: 3 steppers (Y + dual X1/X2 gantry, same direction by default) + laser relay on GPIO26.
// Control: USB serial (115200) AND phone web page over the ESP32's own Wi-Fi AP (http://192.168.4.1).
// Extra telemetry fields (x2_invert, x_invert, xtest...) are additive; v3 clients ignore them.
//
// G-CODE JOBS (website pattern drawing). Unframed lines that look like G-code
// (G.., M<digit>.., X/Y/F/S<number>, N.., '(' ';' '%' '$') use the job protocol:
//   each line -> exactly "ok" or "error:<reason>" (G0/G1: "ok" when the move FINISHES).
//   Needs HELLO + ARM/XARM first. '!' (any time, no newline needed) or STOP aborts.
//   Status JSON lines (start with '{') keep coming; hosts ignore them while waiting.
// Legacy "F2 <seq> <session> ..." frames and the named commands are unchanged.
// See GcodeJob.h and README.md.
constexpr int PROTOCOL_VERSION = 3;
constexpr uint32_t MCU_WDT_TIMEOUT_MS = 3000; // firmware hang -> reset -> relay OFF at boot

using namespace fabricut;
