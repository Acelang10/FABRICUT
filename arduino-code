const char* resetReasonName(esp_reset_reason_t r){
  switch(r){
    case ESP_RST_POWERON: return "POWERON";
    case ESP_RST_EXT: return "EXT";
    case ESP_RST_SW: return "SW";
    case ESP_RST_PANIC: return "PANIC";
    case ESP_RST_INT_WDT: return "INT_WDT";
    case ESP_RST_TASK_WDT: return "TASK_WDT";
    case ESP_RST_WDT: return "WDT";
    case ESP_RST_DEEPSLEEP: return "DEEPSLEEP";
    case ESP_RST_BROWNOUT: return "BROWNOUT";
    case ESP_RST_SDIO: return "SDIO";
#ifdef ESP_RST_USB
    case ESP_RST_USB: return "USB";
#endif
#ifdef ESP_RST_JTAG
    case ESP_RST_JTAG: return "JTAG";
#endif
#ifdef ESP_RST_PWR_GLITCH
    case ESP_RST_PWR_GLITCH: return "PWR_GLITCH";
#endif
#ifdef ESP_RST_CPU_LOCKUP
    case ESP_RST_CPU_LOCKUP: return "CPU_LOCKUP";
#endif
    default: return "UNKNOWN";
  }
}

void printResetInfo(){
  Serial.printf("Last reset: %s, boots: %lu\n",
    resetReasonName(lastResetReason),(unsigned long)bootCount);
}

void loadLimits(Preferences& prefs){
  softLimitOn=prefs.getBool("lim_on",false);
  if(!softLimitOn) return;
  limX0=prefs.getFloat("lim_x0",0);
  limX1=prefs.getFloat("lim_x1",X_MAX_MM);
  limY0=prefs.getFloat("lim_y0",0);
  limY1=prefs.getFloat("lim_y1",Y_MAX_MM);
  if(!(limX0<limX1 && limY0<limY1) || !isfinite(limX0) || !isfinite(limX1) || !isfinite(limY0) || !isfinite(limY1)){
    softLimitOn=false;
  }
}

void saveLimits(){
  Preferences prefs;
  if(!prefs.begin("fabricut",false)) return;
  prefs.putBool("lim_on",softLimitOn);
  prefs.putFloat("lim_x0",limX0);
  prefs.putFloat("lim_x1",limX1);
  prefs.putFloat("lim_y0",limY0);
  prefs.putFloat("lim_y1",limY1);
  prefs.end();
}

void loadStart(Preferences& prefs){
  startOn=prefs.getBool("st_on",false);
  if(!startOn) return;
  startX=prefs.getFloat("st_x",0);
  startY=prefs.getFloat("st_y",0);
  if(!isfinite(startX) || !isfinite(startY)) startOn=false;
}

void saveStart(){
  Preferences prefs;
  if(!prefs.begin("fabricut",false)) return;
  prefs.putBool("st_on",startOn);
  prefs.putFloat("st_x",startX);
  prefs.putFloat("st_y",startY);
  prefs.end();
}

void recordBoot(){
  lastResetReason=esp_reset_reason();
  Preferences prefs;
  if(prefs.begin("fabricut",false)){
    bootCount=prefs.getUInt("boots",0)+1;
    prefs.putUInt("boots",bootCount);
    loadLimits(prefs);
    loadStart(prefs);
    prefs.end();
  } else {
    bootCount=1;
  }
}

const char* stateName(){ return motion.state==State::Moving?"moving":"idle"; }
const char* reasonName(){
  switch(motion.reason){
    case Reason::Boot: return "boot";
    case Reason::Ok: return "ok";
    case Reason::Armed: return "armed";
    case Reason::Moving: return "moving";
    case Reason::Done: return "done";
    case Reason::Stop: return "stop";
    case Reason::SoftLimit: return "soft_limit";
    case Reason::Busy: return "busy";
    case Reason::Lease: return "heartbeat_expired";
    case Reason::NotArmed: return "not_armed";
    case Reason::LaserOn: return "laser_on";
    case Reason::LaserOff: return "laser_off";
    case Reason::ZIgnored: return "z_ignored";
    default: return "bad_command";
  }
}

size_t statusJson(char* buf,size_t n,uint32_t ack){
  uint32_t nowMs=millis();
  uint32_t armLeft=0;
  if(motion.armed && motion.leaseMs){
    uint32_t idle=nowMs-motion.lastHostMs;
    armLeft=idle<motion.leaseMs?motion.leaseMs-idle:0;
  }
  int len=snprintf(buf,n,
    "{\"v\":%d,\"session\":%lu,\"ack\":%lu,\"mode\":\"STEPPER_LASER\",\"state\":\"%s\",\"armed\":%s,"
    "\"x\":%.3f,\"y\":%.3f,\"feed\":%lu,\"coils\":\"%s\",\"laser\":\"%s\",\"laser_latched\":%s,"
    "\"laser_pin\":%u,\"laser_active_low\":%s,\"reason\":\"%s\","
    "\"steps_per_mm\":%.2f,\"x_min\":%.1f,\"x_max\":%.1f,\"y_min\":%.1f,\"y_max\":%.1f,\"soft_limit\":%s,"
    "\"x_steps\":%ld,\"y_steps\":%ld,\"x2_invert\":%s,\"x_invert\":%s,\"xtest\":\"%s\",\"xtest_legs_left\":%lu,"
    "\"xtest_sps\":%lu,\"mtest\":\"%s\",\"single\":\"%s\",\"single_sps\":%lu,\"lease_ms\":%lu,\"arm_left_ms\":%lu,\"web\":%s,\"web_motion\":%s,"
    "\"tool\":\"%s\",\"tool_mode\":\"%s\",\"job\":\"%s\",\"job_src\":\"%s\",\"job_lines\":%lu,\"job_reason\":\"%s\","
    "\"job_loaded\":%lu,\"job_total_lines\":%lu,\"job_file_line\":%lu,\"single_enabled\":%s,"
    "\"start_on\":%s,\"start_x\":%.3f,\"start_y\":%.3f,"
    "\"reset\":\"%s\",\"boots\":%lu}\n",
    PROTOCOL_VERSION,(unsigned long)sessionId,(unsigned long)ack,stateName(),motion.armed?"true":"false",
    motion.xMm(),motion.yMm(),(unsigned long)activeFeed,
    motion.coilsOn?"on":"off",motion.laser.on?"on":"off",motion.laserLatched?"true":"false",
    (unsigned)LASER_RELAY_PIN,LASER_RELAY_ACTIVE_LOW?"true":"false",reasonName(),
    STEPS_PER_MM_XY,
    softLimitOn?limX0:0.f, softLimitOn?limX1:0.f,
    softLimitOn?limY0:0.f, softLimitOn?limY1:0.f,
    softLimitOn?"true":"false",
    (long)motion.xSteps,(long)motion.ySteps,motion.x2Invert?"true":"false",motion.xInvert?"true":"false",
    motion.testActive?"running":"idle",(unsigned long)motion.testLegsLeft,
    (unsigned long)motion.testSps,motion.testMotorsName(),motion.singleName(),(unsigned long)motion.singleSps,(unsigned long)motion.leaseMs,(unsigned long)armLeft,
    wifiUp?"true":"false",webMotion?"true":"false",
    motion.toolOn?"on":"off",TOOL_MODE==TOOL_LASER?"laser":"dry",job.stateName(),job.sourceName(),
    (unsigned long)job.lines,job.why,(unsigned long)jobLen,(unsigned long)jobTotalLines,(unsigned long)jobLineNo,
    SINGLE_MOTOR_TEST?"true":"false",
    startOn?"true":"false",startX,startY,
    resetReasonName(lastResetReason),(unsigned long)bootCount);
  if(len<0) len=0;
  if((size_t)len>=n) len=(int)n-1;
  return (size_t)len;
}

void status(uint32_t ack=0){
  char buf[1500];
  statusJson(buf,sizeof(buf),ack);
  Serial.print(buf);
  lastStatusMs=millis();
}

bool insideWork(float x,float y){
  if(!softLimitOn) return true;
  return x>=limX0 && x<=limX1 && y>=limY0 && y<=limY1;
}

bool parseFloatToken(const char* s,float& out){
  if(!s||!*s) return false;
  char* end=nullptr;
  out=strtof(s,&end);
  return end && end!=s && *end=='\0' && isfinite(out);
}

bool parseU32(const char* s,uint32_t& out){
  if(!s||!*s) return false;
  char* end=nullptr;
  unsigned long v=strtoul(s,&end,10);
  if(!end||end==s||*end!='\0'||v>0xFFFFFFFFul) return false;
  out=(uint32_t)v; return true;
}

void newSession(uint32_t seq){
  motion.stop(Reason::Ok); // laser OFF, disarmed
  sessionId=esp_random(); if(!sessionId) sessionId=1;
  lastSeq=seq; activeFeed=DEFAULT_FEED_MM_PER_MIN;
  printResetInfo();
  status(seq);
}

void handleLine(char* line){
  while(*line && isspace((unsigned char)*line)) ++line;
  char* end=line+strlen(line);
  while(end>line && isspace((unsigned char)end[-1])) --end;
  *end=0;
  if(!*line) return;

  uint32_t nowMs=millis();
  uint32_t nowUs=micros();

  char* tokens[12];
  unsigned count=0;
  char* save=nullptr;
  for(char* p=strtok_r(line," ",&save); p && count<12; p=strtok_r(nullptr," ",&save)){
    tokens[count++]=p;
  }
  if(!count) return;

  // Any rejected command forces the laser OFF.
  auto fail=[&](Reason r){ motion.reject(r); status(lastSeq); };

  if(!strcmp(tokens[0],"F2")){
    uint32_t seq=0;
    if(count==3 && parseU32(tokens[1],seq) && !strcmp(tokens[2],"HELLO")){ newSession(seq); return; }
    uint32_t session=0;
    if(count<4 || !parseU32(tokens[1],seq) || !parseU32(tokens[2],session) ||
       session!=sessionId || !sessionId || seq<=lastSeq){
      motion.stop(Reason::BadCommand); status(seq); return;
    }
    lastSeq=seq;
    unsigned cmdCount=count-3;
    for(unsigned i=0;i<cmdCount;i++) tokens[i]=tokens[i+3];
    count=cmdCount;
    if(!count){ status(seq); return; }
  } else {
    if(count==1 && !strcasecmp(tokens[0],"HELLO")){ newSession(0); return; }
    if(!sessionId){
      motion.laserOff();
      Serial.printf("{\"v\":%d,\"error\":\"say HELLO first\"}\n",PROTOCOL_VERSION);
      return;
    }
  }

  uint32_t ack=lastSeq;
  motion.ping(nowMs);

  if(count==1 && (!strcasecmp(tokens[0],"STOP") || !strcmp(tokens[0],"!") || !strcasecmp(tokens[0],"M0") ||
                  !strcasecmp(tokens[0],"DISARM"))){
    storedJob=false; jobUpload=false;
    motion.stop(Reason::Stop); status(ack); return;
  }
  if(count==1 && !strcasecmp(tokens[0],"STATUS")){ status(ack); return; }
  if(count==1 && !strcasecmp(tokens[0],"ARM")){
    if(motion.busy()){ fail(Reason::Busy); return; }
    motion.arm(nowMs); status(ack); return;
  }
  // XARM: same as ARM but with a 30 s host-silence lease, for typing X tests by hand.
  if(count==1 && !strcasecmp(tokens[0],"XARM")){
    if(motion.busy()){ fail(Reason::Busy); return; }
    motion.arm(nowMs,XARM_LEASE_MS); status(ack); return;
  }

  // WEBARM: phone ARM. Auto-disarms after WEB_ARM_IDLE_MS without a button press
  // (every accepted command refreshes it). A running X test also keeps it alive.
  if(count==1 && !strcasecmp(tokens[0],"WEBARM")){
    if(motion.busy()){ fail(Reason::Busy); return; }
    motion.arm(nowMs,WEB_ARM_IDLE_MS); status(ack); return;
  }

  // ---- X axis back-and-forth test (both X motors in lockstep, Y off, laser OFF) ----
  // XTEST [steps] [cycles] [sps]   forward <steps>, back <steps>, repeated <cycles> times
  // XFWD [steps] [sps] / XBACK [steps] [sps]   one move
  bool isXTest=!strcasecmp(tokens[0],"XTEST");
  bool isXFwd=!strcasecmp(tokens[0],"XFWD");
  bool isXBack=!strcasecmp(tokens[0],"XBACK");
  if(isXTest || isXFwd || isXBack){
    uint32_t steps=(uint32_t)XTEST_DEFAULT_STEPS, cycles=XTEST_DEFAULT_CYCLES, sps=motion.testSps;
    unsigned idx=1;
    if(count>idx && !parseU32(tokens[idx++],steps)){ fail(Reason::BadCommand); return; }
    if(isXTest && count>idx && !parseU32(tokens[idx++],cycles)){ fail(Reason::BadCommand); return; }
    if(count>idx && !parseU32(tokens[idx++],sps)){ fail(Reason::BadCommand); return; }
    if(count>idx || steps>(uint32_t)XTEST_MAX_STEPS || cycles<1 || cycles>XTEST_MAX_CYCLES){ fail(Reason::BadCommand); return; }
    int32_t first=isXBack?-(int32_t)steps:(int32_t)steps;
    uint32_t legs=isXTest?2*cycles:1;
    motion.startXTest(first,legs,sps,nowMs,nowUs); status(ack); return;
  }

  // MOTORTEST [X|Y|X1|X2] [steps] [cycles] [sps]
  // One-revolution-style check: forward, pause, back. Laser OFF.
  // Default: X (both motors), 4096 half-steps (1 rev), 1 cycle, current speed.
  if(!strcasecmp(tokens[0],"MOTORTEST")){
    TestMotors axis=TestMotors::XBoth;
    unsigned idx=1;
    if(count>idx){
      if(!strcasecmp(tokens[idx],"X")){ axis=TestMotors::XBoth; idx++; }
      else if(!strcasecmp(tokens[idx],"Y")){ axis=TestMotors::Y; idx++; }
      else if(!strcasecmp(tokens[idx],"X1")){ axis=TestMotors::X1; idx++; }
      else if(!strcasecmp(tokens[idx],"X2")){ axis=TestMotors::X2; idx++; }
    }
    uint32_t steps=(uint32_t)MOTORTEST_DEFAULT_STEPS, cycles=MOTORTEST_DEFAULT_CYCLES, sps=motion.testSps;
    if(count>idx && !parseU32(tokens[idx++],steps)){ fail(Reason::BadCommand); return; }
    if(count>idx && !parseU32(tokens[idx++],cycles)){ fail(Reason::BadCommand); return; }
    if(count>idx && !parseU32(tokens[idx++],sps)){ fail(Reason::BadCommand); return; }
    if(count>idx || steps<1 || steps>(uint32_t)XTEST_MAX_STEPS || cycles<1 || cycles>XTEST_MAX_CYCLES){
      fail(Reason::BadCommand); return;
    }
    motion.startMotorTest(axis,(int32_t)steps,2*cycles,sps,nowMs,nowUs,MOTORTEST_DWELL_MS);
    status(ack); return;
  }

  // SINGLE [R|F|B|+|-|SLOW|MED|HIGH|?]  video-style one-motor test (default X1).
  // R = one revolution CW; F = continuous CW; B = continuous CCW; +/- speed; presets.
  // Bare R, +, - also accepted after HELLO (bare F is not: it would clash with F200).
  if(SINGLE_MOTOR_TEST){
    auto singleHelp=[](){
      Serial.println("SINGLE: R=1 rev CW  F=spin CW  B=spin CCW  +/- speed  SLOW|MED|HIGH  STOP. ARM first. Other motors off.");
    };
    bool isSingle=!strcasecmp(tokens[0],"SINGLE");
    bool bareR=count==1 && !strcasecmp(tokens[0],"R");
    bool barePlus=count==1 && !strcmp(tokens[0],"+");
    bool bareMinus=count==1 && !strcmp(tokens[0],"-");
    if(isSingle || bareR || barePlus || bareMinus){
      const char* op=nullptr;
      if(isSingle){
        if(count==1 || (count==2 && (!strcmp(tokens[1],"?") || !strcasecmp(tokens[1],"HELP")))){
          singleHelp(); motion.reason=Reason::Ok; status(ack); return;
        }
        if(count!=2){ fail(Reason::BadCommand); return; }
        op=tokens[1];
      } else if(bareR) op="R";
      else if(barePlus) op="+";
      else op="-";

      if(!strcasecmp(op,"R")){
        motion.startSingleRev(nowMs,nowUs); status(ack); return;
      }
      if(!strcasecmp(op,"F")){
        motion.startSingleSpin(1,nowMs,nowUs); status(ack); return;
      }
      if(!strcasecmp(op,"B")){
        motion.startSingleSpin(-1,nowMs,nowUs); status(ack); return;
      }
      if(!strcmp(op,"+")){
        motion.bumpSingleSpeed((int32_t)SINGLE_MOTOR_SPEED_STEP); status(ack); return;
      }
      if(!strcmp(op,"-")){
        motion.bumpSingleSpeed(-(int32_t)SINGLE_MOTOR_SPEED_STEP); status(ack); return;
      }
      if(!strcasecmp(op,"SLOW")){
        motion.applySingleSpeed(SINGLE_MOTOR_SLOW_SPS); motion.reason=Reason::Ok; status(ack); return;
      }
      if(!strcasecmp(op,"MED") || !strcasecmp(op,"MEDIUM")){
        motion.applySingleSpeed(SINGLE_MOTOR_MED_SPS); motion.reason=Reason::Ok; status(ack); return;
      }
      if(!strcasecmp(op,"HIGH")){
        motion.applySingleSpeed(SINGLE_MOTOR_HIGH_SPS); motion.reason=Reason::Ok; status(ack); return;
      }
      fail(Reason::BadCommand); return;
    }
  }

  // XSPEED <steps/s>: speed for later X tests (50..700).
  if(count==2 && !strcasecmp(tokens[0],"XSPEED")){
    uint32_t v=0;
    if(!parseU32(tokens[1],v) || v<XTEST_MIN_SPS || v>XTEST_MAX_SPS){ fail(Reason::BadCommand); return; }
    if(motion.busy()){ fail(Reason::Busy); return; }
    motion.testSps=v; motion.reason=Reason::Ok; status(ack); return;
  }
  // INVX2 [0|1]: flip (or set) X2 direction relative to X1 if the X motors fight each other.
  // INVX  [0|1]: flip (or set) both X motors if XFWD goes the wrong way. RAM only; edit FabricutConfig.h to keep.
  bool isInvX2=!strcasecmp(tokens[0],"INVX2"), isInvX=!strcasecmp(tokens[0],"INVX");
  if((isInvX2||isInvX) && count<=2){
    if(motion.busy()){ fail(Reason::Busy); return; }
    bool& flag=isInvX2?motion.x2Invert:motion.xInvert;
    if(count==2){
      if(!strcmp(tokens[1],"1")) flag=true;
      else if(!strcmp(tokens[1],"0")) flag=false;
      else { fail(Reason::BadCommand); return; }
    } else flag=!flag;
    motion.deenergize(); // re-energize cleanly on the next move
    motion.reason=Reason::Ok; status(ack); return;
  }
  if(count>=1 && (!strcasecmp(tokens[0],"SET_ORIGIN") || !strcasecmp(tokens[0],"G92") || !strcmp(tokens[0],"G92.0"))){
    // Simple subset: current position becomes (0,0). Laser OFF while re-zeroing.
    if(motion.busy()){ fail(Reason::Busy); return; }
    motion.laserOff(); motion.setOrigin(); status(ack); return;
  }
  // M3 closes the relay immediately while the machine is idle, so Laser ON can
  // be tested without a cut. G0, jog, and motor tests open it. M5 opens it.
  // S is ignored: the relay has no power control.
  if(count>=1 && (!strcasecmp(tokens[0],"M3") || !strcasecmp(tokens[0],"M4") || !strcasecmp(tokens[0],"LASERON"))){
    motion.toolCmd(true,nowMs);
    if(motion.laserLatched && !motion.busy()) motion.laser.set(true);
    status(ack); return;
  }
  // M5 = laser relay OFF. PENUP/ZUP kept as harmless aliases for old clients.
  if(count>=1 && (!strcasecmp(tokens[0],"M5") || !strcasecmp(tokens[0],"LASEROFF") ||
                  !strcasecmp(tokens[0],"PENUP") || !strcasecmp(tokens[0],"ZUP"))){
    motion.laserOff(); motion.reason=Reason::LaserOff; status(ack); return;
  }

  // LIMIT OFF  or  LIMIT <xmin> <xmax> <ymin> <ymax>   (millimetres, from the website)
  if(count>=2 && !strcasecmp(tokens[0],"LIMIT")){
    if(motion.busy()){ fail(Reason::Busy); return; }
    if(count==2 && !strcasecmp(tokens[1],"OFF")){
      softLimitOn=false; saveLimits(); motion.reason=Reason::Ok; status(ack); return;
    }
    float x0,x1,y0,y1;
    if(count!=5 || !parseFloatToken(tokens[1],x0) || !parseFloatToken(tokens[2],x1) ||
       !parseFloatToken(tokens[3],y0) || !parseFloatToken(tokens[4],y1) || x0>=x1 || y0>=y1){
      fail(Reason::BadCommand); return;
    }
    limX0=x0; limX1=x1; limY0=y0; limY1=y1; softLimitOn=true;
    saveLimits();
    motion.reason=Reason::Ok; status(ack); return;
  }

  // SETPOINT <x> <y>  save a travel target in millimetres. Kept after reset or unplug.
  if(count==3 && !strcasecmp(tokens[0],"SETPOINT")){
    if(motion.busy()){ fail(Reason::Busy); return; }
    float x,y;
    if(!parseFloatToken(tokens[1],x) || !parseFloatToken(tokens[2],y) || !isfinite(x) || !isfinite(y)){
      fail(Reason::BadCommand); return;
    }
    if(!insideWork(x,y)){ fail(Reason::SoftLimit); return; }
    startX=x; startY=y; startOn=true;
    saveStart();
    motion.reason=Reason::Ok; status(ack); return;
  }

  // STARTPT [Fmm/min]  travel to the saved point. Laser OFF. Needs ARM.
  if((count==1 || count==2) && !strcasecmp(tokens[0],"STARTPT")){
    if(!startOn){ fail(Reason::BadCommand); return; }
    if(!motion.armed){ fail(Reason::NotArmed); return; }
    if(motion.busy()){ fail(Reason::Busy); return; }
    uint32_t feed=activeFeed;
    if(count==2){
      uint32_t f=0;
      const char* word=tokens[1];
      if(word[0]=='F'||word[0]=='f') word++;
      if(!parseU32(word,f) || f<1){ fail(Reason::BadCommand); return; }
      feed=f; activeFeed=f;
    }
    if(!insideWork(startX,startY)){ fail(Reason::SoftLimit); return; }
    motion.laser.off();
    motion.moveAbsoluteMm(startX,startY,false,feed,nowMs,nowUs);
    status(ack); return;
  }

  // JOG X|Y <mm> [Fmm/min]  (travel: laser OFF). JOG Z is ignored.
  if(count>=3 && !strcasecmp(tokens[0],"JOG")){
    char axis=toupper(tokens[1][0]);
    float delta=0; if(!parseFloatToken(tokens[2],delta)){ fail(Reason::BadCommand); return; }
    float nx=motion.xMm(), ny=motion.yMm();
    if(axis=='X') nx+=delta; else if(axis=='Y') ny+=delta;
    if(axis=='X' || axis=='Y'){ if(!insideWork(nx,ny)){ fail(Reason::SoftLimit); return; } }
    uint32_t feed=activeFeed;
    if(count>=4 && (tokens[3][0]=='F'||tokens[3][0]=='f')){
      uint32_t f=0; if(!parseU32(tokens[3]+1,f)){ fail(Reason::BadCommand); return; }
      feed=f; activeFeed=f;
    } else if(count>=4 && parseU32(tokens[3],feed)){ activeFeed=feed; }
    motion.jogMm(axis,delta,feed,nowMs,nowUs); status(ack); return;
  }

  // G0 (rapid/travel: laser OFF) / G1 (cut: laser ON if M3 latched) [X..] [Y..] [Z.. ignored] [F..]
  bool isG0=!strcasecmp(tokens[0],"G0") || !strcasecmp(tokens[0],"G00");
  bool isG1=!strcasecmp(tokens[0],"G1") || !strcasecmp(tokens[0],"G01");
  if(isG0 || isG1){
    if(isG0) motion.laser.off(); // before parsing anything
    float xmm=motion.xMm(), ymm=motion.yMm();
    uint32_t feed=activeFeed;
    bool any=false, sawZ=false;
    for(unsigned i=1;i<count;i++){
      char axis=toupper(tokens[i][0]);
      float v=0;
      if(!parseFloatToken(tokens[i]+1,v)){ fail(Reason::BadCommand); return; }
      if(axis=='X'){ xmm=v; any=true; }
      else if(axis=='Y'){ ymm=v; any=true; }
      else if(axis=='Z'){ sawZ=true; } // no Z axis: ignored
      else if(axis=='F'){ if(v<1){ fail(Reason::BadCommand); return; } feed=(uint32_t)lroundf(v); activeFeed=feed; }
      else if(axis=='S'){ /* no PWM power control on a relay */ }
      else { fail(Reason::BadCommand); return; }
    }
    if(!any){
      if(sawZ){ if(isG0) motion.laserOff(); motion.reason=Reason::ZIgnored; status(ack); return; }
      fail(Reason::BadCommand); return;
    }
    if(!insideWork(xmm,ymm)){ fail(Reason::SoftLimit); return; }
    motion.moveAbsoluteMm(xmm,ymm,isG1,feed,nowMs,nowUs); status(ack); return;
  }

  if(count==1 && (tokens[0][0]=='F'||tokens[0][0]=='f')){
    uint32_t f=0; if(!parseU32(tokens[0]+1,f)){ fail(Reason::BadCommand); return; }
    activeFeed=f; motion.reason=Reason::Ok; status(ack); return;
  }

  // Stored file: JOBUP, then one JOBLINE per G-code line, JOBEND, then JOBRUN.
  // JOBRUN clears the arm lease. The file then runs with no host traffic.
  if(count==1 && !strcasecmp(tokens[0],"JOBUP")){
    if(job.running() || motion.busy() || usbPending || storedJob){
      motion.reason=Reason::Busy; status(ack); return;
    }
    jobLen=0; jobBuf[0]=0; jobTotalLines=0; jobPos=0; jobLineNo=0;
    jobUpload=true; jobUploadBad=false; webJobErr="";
    motion.reason=Reason::Ok; status(ack); return;
  }
  if(!strcasecmp(tokens[0],"JOBLINE")){
    if(!jobUpload || jobUploadBad){ motion.reason=Reason::BadCommand; status(ack); return; }
    char stored[JOB_MAX_LINE+1];
    size_t n=0; bool tooLong=false;
    for(unsigned i=1;i<count;i++){
      size_t L=strlen(tokens[i]);
      size_t need=L+(n?1:0);
      if(n+need>JOB_MAX_LINE){ tooLong=true; break; }
      if(n) stored[n++]=' ';
      memcpy(stored+n,tokens[i],L); n+=L;
    }
    stored[n]=0;
    if(tooLong || !n || jobLen+n+1>JOB_MAX_BYTES){
      jobUploadBad=true;
      webJobErr=tooLong||!n?"line_too_long":"too_large";
      motion.reason=Reason::BadCommand; status(ack); return;
    }
    memcpy(jobBuf+jobLen,stored,n); jobLen+=n;
    jobBuf[jobLen++]='\n'; jobBuf[jobLen]=0;
    motion.reason=Reason::Ok; status(ack); return;
  }
  if(count==1 && !strcasecmp(tokens[0],"JOBEND")){
    if(!jobUpload){ motion.reason=Reason::BadCommand; status(ack); return; }
    jobUpload=false;
    if(jobUploadBad || !jobLen){
      const char* why=jobUploadBad?(webJobErr[0]?webJobErr:"bad_line"):"empty";
      jobLen=0; jobBuf[0]=0; jobTotalLines=0; jobPos=0; jobLineNo=0;
      webJobErr=why;
      motion.reason=Reason::BadCommand; status(ack); return;
    }
    jobTotalLines=countJobLines(jobBuf,jobLen);
    jobPos=0; jobLineNo=0; webJobErr="";
    motion.reason=Reason::Ok; status(ack); return;
  }
  if(count==1 && !strcasecmp(tokens[0],"JOBRUN")){
    if(jobUpload || jobUploadBad || !jobLen){ motion.reason=Reason::BadCommand; status(ack); return; }
    if(REQUIRE_ARM && !motion.armed){ fail(Reason::NotArmed); return; }
    if(motion.busy() || job.running() || usbPending || storedJob){ fail(Reason::Busy); return; }
    beginStoredJob(nowMs);
    status(ack); return;
  }

  fail(Reason::BadCommand);
}

// ================= G-code jobs =================
void emergencyStop(){
  storedJob=false; jobUpload=false;
  motion.stop(Reason::Stop);   // laser/tool OFF, coils OFF, disarmed; job.tick() marks the job aborted
  webMotion=false;
  status(lastSeq);
}

// One USB G-code line -> "ok" / "error:<reason>" (G0/G1: "ok" later, when the move ends).
void usbGcode(char* line){
  if(usbPending){ Serial.print("error:busy\n"); return; } // host must wait for the previous reply
  webMotion=false;
  const char* err="";
  Submit r=job.submit(motion,line,JobSource::Usb,millis(),micros(),err);
  if(r==Submit::Ok) Serial.print("ok\n");
  else if(r==Submit::Pending) usbPending=true;
  else Serial.printf("error:%s\n",err);
}

uint32_t countJobLines(const char* b,size_t n){
  uint32_t lines=0; bool content=false;
  for(size_t i=0;i<n;i++){
    char c=b[i];
    if(c=='\n'){ if(content) lines++; content=false; }
    else if(c!=' ' && c!='\r' && c!='\t') content=true;
  }
  if(content) lines++;
  return lines;
}

// Run a file already stored in jobBuf. No host traffic is required after this.
void beginStoredJob(uint32_t nowMs){
  jobPos=0; jobLineNo=0;
  webMotion=false; webJobErr="";
  storedJob=true;
  motion.ping(nowMs);
  job.begin(motion,JobSource::Web,nowMs);
  motion.leaseMs=0; // silence must not expire the arm mid-cut
}

// Feed a stored file (USB JOBRUN or phone upload) one line per finished move.
void webJobService(){
  if(!storedJob || !job.running()) return;
  for(unsigned budget=0; budget<8 && storedJob && job.running() && !motion.busy(); ++budget){
    if(jobPos>=jobLen){ job.finish(motion,"end"); status(lastSeq); return; }
    char line[JOB_MAX_LINE+1]; size_t n=0; bool tooLong=false;
    while(jobPos<jobLen && jobBuf[jobPos]!='\n'){
      char c=jobBuf[jobPos++];
      if(c=='\r') continue;
      if(c=='\t') c=' ';
      if(n<JOB_MAX_LINE) line[n++]=c; else tooLong=true;
    }
    if(jobPos<jobLen) jobPos++; // skip '\n'
    line[n]=0; jobLineNo++;
    if(tooLong){ webJobErr="line_too_long"; job.abort(motion,"line_too_long"); status(lastSeq); return; }
    const char* q=line; while(*q==' ') ++q;
    if(!*q) continue;           // blank line
    const char* err="";
    if(job.submit(motion,line,JobSource::Web,millis(),micros(),err)==Submit::Error){
      webJobErr=err;
      if(job.running()) job.abort(motion,err);
      status(lastSeq);
      return;
    }
  }
}

void webJobReply(int code,const char* error){
  char buf[96];
  snprintf(buf,sizeof(buf),"{\"ok\":false,\"error\":\"%s\"}",error);
  web.sendHeader("Cache-Control","no-store");
  web.send(code,"application/json",buf);
}

// POST /job, body = G-code text (Content-Type: text/plain). Streamed into RAM.
void jobRaw(HTTPRaw& raw){
  esp_task_wdt_reset();         // a slow 64 KB upload must not trip the 3 s watchdog
  lastWebSeenMs=millis();
  if(raw.status==RAW_START){
    upRefused=job.running() || motion.busy() || usbPending;
    upOverflow=false; upAborted=false; upGotData=true; upLen=0;
    if(!upRefused){ jobLen=0; jobBuf[0]=0; jobTotalLines=0; jobPos=0; jobLineNo=0; }
  } else if(raw.status==RAW_WRITE){
    if(upRefused || upOverflow) return;
    if(upLen+raw.currentSize>JOB_MAX_BYTES){ upOverflow=true; return; }
    memcpy(jobBuf+upLen,raw.buf,raw.currentSize); upLen+=raw.currentSize;
  } else if(raw.status==RAW_END){
    if(upRefused) return;
    if(upOverflow){ jobLen=0; return; }
    jobBuf[upLen]=0; jobLen=upLen;
    jobTotalLines=countJobLines(jobBuf,jobLen);
  } else { // RAW_ABORTED
    if(!upRefused){ upAborted=true; jobLen=0; }
  }
}

void jobUploadDone(){
  lastWebSeenMs=millis();
  if(!upGotData){ webJobReply(400,"send the G-code as the raw request body (Content-Type: text/plain)"); return; }
  upGotData=false;
  if(upRefused){ webJobReply(409,"busy"); return; }
  if(upOverflow){ webJobReply(413,"too_large"); return; }
  if(upAborted || !jobLen){ webJobReply(400,upAborted?"upload_aborted":"empty"); return; }
  webJobErr="";
  char buf[96];
  snprintf(buf,sizeof(buf),"{\"ok\":true,\"bytes\":%lu,\"lines\":%lu}",(unsigned long)jobLen,(unsigned long)jobTotalLines);
  web.sendHeader("Cache-Control","no-store");
  web.send(200,"application/json",buf);
}

class JobUploadHandler : public RequestHandler {
public:
  bool canHandle(HTTPMethod m,const String& uri) override { return m==HTTP_POST && uri=="/job"; }
  bool canHandle(WebServer&,HTTPMethod m,const String& uri) override { return m==HTTP_POST && uri=="/job"; }
  bool canRaw(const String& uri) override { return uri=="/job"; }
  bool canRaw(WebServer&,const String& uri) override { return uri=="/job"; }
  bool handle(WebServer&,HTTPMethod,const String&) override { jobUploadDone(); return true; }
  void raw(WebServer&,const String&,HTTPRaw& r) override { jobRaw(r); }
};

// POST/GET /jobstart: run the uploaded file. Needs ARM; same limits as USB jobs.
void webJobStart(){
  lastWebSeenMs=millis();
  if(!jobLen){ webJobReply(400,"no_job"); return; }
  if(REQUIRE_ARM && !motion.armed){ webJobReply(409,"not_armed"); return; }
  if(motion.busy() || job.running() || usbPending){ webJobReply(409,"busy"); return; }
  if(jobUpload){ webJobReply(409,"uploading"); return; }
  beginStoredJob(millis());
  status(lastSeq);
  webSendStatus();
}

// ================= Phone controller (Wi-Fi AP) =================
// Only these commands are accepted from the phone. They run through the SAME
// handleLine() validation and limits as serial. No laser, G-code or JOG.
// MOTORTEST may move Y or a single X motor. SINGLE is the video-style one-motor
// test (default X1). The laser stays OFF.
void webSendStatus(){
  char buf[1500];
  statusJson(buf,sizeof(buf),lastSeq);
  web.sendHeader("Cache-Control","no-store");
  web.send(200,"application/json",buf);
}

void webStop(){ // always allowed, no session/arm needed, non-blocking
  lastWebSeenMs=millis();
  storedJob=false; jobUpload=false;
  motion.stop(Reason::Stop);
  webMotion=false;
  status(lastSeq);
  webSendStatus();
}

void webCmd(){
  lastWebSeenMs=millis();
  String c=web.arg("c");
  c.trim();
  char line[64];
  if(c.length()==0 || c.length()>=sizeof(line)){ motion.reject(Reason::BadCommand); webSendStatus(); return; }
  strncpy(line,c.c_str(),sizeof(line)); line[sizeof(line)-1]=0;
  for(char* p=line; *p; ++p){ if(*p<32 || *p>126){ motion.reject(Reason::BadCommand); webSendStatus(); return; } }
  char first[16]; size_t i=0;
  while(line[i] && line[i]!=' ' && i<sizeof(first)-1){ first[i]=line[i]; ++i; }
  first[i]=0;
  if(!webAllowed(first)){ motion.reject(Reason::BadCommand); webSendStatus(); return; }
  if(!strcasecmp(first,"STOP") || !strcasecmp(first,"DISARM")){ webStop(); return; }
  if(!strcasecmp(first,"ARM")){ if(line[3]){ motion.reject(Reason::BadCommand); webSendStatus(); return; } strcpy(line,"WEBARM"); }
  if(!sessionId) newSession(0); // phone gets a session automatically (laser OFF, disarmed)
  bool wasBusy=motion.busy();
  handleLine(line);
  if(!wasBusy && motion.busy()) webMotion=true;
  webSendStatus();
}

void webStatus(){ lastWebSeenMs=millis(); webSendStatus(); }

void webRoot(){
  lastWebSeenMs=millis();
  web.sendHeader("Cache-Control","no-store");
  web.send_P(200,"text/html",CONTROL_PAGE);
}

void webNotFound(){ // captive portal: any other URL -> control page
  web.sendHeader("Location",String("http://")+WiFi.softAPIP().toString()+"/",true);
  web.send(302,"text/plain","");
}

void webAndroidProbe(){ // Android captive-portal probe: 204 = "stay on this network"
  web.sendHeader("Cache-Control","no-store");
  web.send(204);
}

void webAppleProbe(){ // iOS hotspot-detect: "Success" = don't drop a no-internet AP
  web.sendHeader("Cache-Control","no-store");
  web.send(200,"text/html","<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>");
}

// Start or re-start the soft-AP only. Does not touch the web/DNS servers.
bool startAp(){
  WiFi.persistent(false);
  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false); // modem power save off (low latency for STOP, fewer idle drops)
  IPAddress ip(192,168,4,1), mask(255,255,255,0);
  WiFi.softAPConfig(ip,ip,mask);
  if(!WiFi.softAP(WIFI_AP_SSID,WIFI_AP_PASSWORD,WIFI_AP_CHANNEL,0,WIFI_AP_MAX_CLIENTS)){
    return false;
  }
  WiFi.setTxPower((wifi_power_t)WIFI_AP_TX_POWER);
  WiFi.setSleep(false);
  esp_wifi_set_ps(WIFI_PS_NONE);
  return true;
}

bool apIsUp(){
  wifi_mode_t mode=WiFi.getMode();
  if(mode!=WIFI_AP && mode!=WIFI_AP_STA) return false;
  return WiFi.softAPIP()==IPAddress(192,168,4,1);
}

void wifiWatchdog(uint32_t nowMs){
  if(!WIFI_CONTROL_ENABLED || !wifiUp) return;
  static uint32_t lastCheck=0;
  if((uint32_t)(nowMs-lastCheck)<WIFI_AP_WATCHDOG_MS) return;
  lastCheck=nowMs;
  if(apIsUp()) return; // loop never restarts a healthy AP
  Serial.println("{\"wifi\":\"ap_restart\"}");
  if(!startAp()) Serial.println("{\"wifi\":\"ap_failed\"}");
}

void setupWifi(){
  if(!WIFI_CONTROL_ENABLED) return;
  if(!startAp()){
    Serial.println("{\"wifi\":\"ap_failed\"}");
    return;
  }
  IPAddress ip(192,168,4,1);
  dns.setErrorReplyCode(DNSReplyCode::NoError);
  dns.start(53,"*",ip);
  web.on("/",HTTP_GET,webRoot);
  web.on("/status",HTTP_GET,webStatus);
  web.on("/cmd",webCmd);
  web.on("/stop",webStop);      // GET or POST (sendBeacon)
  web.addHandler(new JobUploadHandler()); // POST /job  (G-code text body)
  web.on("/jobstart",webJobStart);        // GET or POST
  web.on("/generate_204",HTTP_GET,webAndroidProbe);
  web.on("/gen_204",HTTP_GET,webAndroidProbe);
  web.on("/hotspot-detect.html",HTTP_GET,webAppleProbe);
  web.onNotFound(webNotFound);
  web.begin();
  wifiUp=true;
  Serial.printf("{\"wifi\":\"ap\",\"ssid\":\"%s\",\"url\":\"http://192.168.4.1/\"}\n",WIFI_AP_SSID);
}

void webService(uint32_t nowMs){
  if(!wifiUp) return;
  wifiWatchdog(nowMs);
  dns.processNextRequest();
  web.handleClient();
  // A file already in jobBuf keeps cutting if the phone stops polling.
  if(webMotion){
    if(!motion.busy()) webMotion=false;
    else if(webDeadmanTrip(webMotion,motion.busy(),millis(),lastWebSeenMs)){
      motion.stop(Reason::Lease); // phone stopped polling -> STOP + disarm
      webMotion=false;
      status(lastSeq);
    }
  }
  (void)nowMs;
}

void setupWatchdog(){
#if ESP_IDF_VERSION_MAJOR >= 5
  esp_task_wdt_config_t cfg={};
  cfg.timeout_ms=MCU_WDT_TIMEOUT_MS;
  cfg.idle_core_mask=0;
  cfg.trigger_panic=true;
  if(esp_task_wdt_init(&cfg)!=ESP_OK) esp_task_wdt_reconfigure(&cfg);
#else
  esp_task_wdt_init(MCU_WDT_TIMEOUT_MS/1000,true);
#endif
  esp_task_wdt_add(NULL);
}

// A 5V active-low module stays closed on an ESP32 3.3 V HIGH. Leave the pin
// floating so the module's own pull-up opens the coil. A latched M3 keeps the
// coil closed while the head is still; travel clears that in the motion core.
void releaseIdleRelay(){
  if(motion.laser.on || (motion.laserLatched && !motion.busy())) return;
  if(LASER_RELAY_ACTIVE_LOW){
    digitalWrite(LASER_RELAY_PIN, HIGH);
    pinMode(LASER_RELAY_PIN, INPUT);
  } else {
    pinMode(LASER_RELAY_PIN, OUTPUT);
    digitalWrite(LASER_RELAY_PIN, LOW);
  }
}

void setup(){
  // Relay OFF before anything else. Keep laser 12V and motor 5V supplies OFF while flashing.
  releaseIdleRelay();
  motion.begin();
  releaseIdleRelay();
  Serial.setTxBufferSize(2048); // status lines never block the step loop
  Serial.begin(115200);
  recordBoot();
  printResetInfo();
  setupWifi();      // relay is already OFF; Wi-Fi start can take a moment
  setupWatchdog();
  status(0);
}

void loop(){
  esp_task_wdt_reset();
  uint32_t nowMs=millis();
  uint32_t nowUs=micros();
  if(storedJob) motion.leaseMs=0; // a missing STATUS must not stop this file
  motion.tick(nowMs,nowUs);
  webService(nowMs);
  motion.tick(millis(),micros());
  // Keep a latched Laser ON closed while the head is still. Travel sets busy
  // and the motion core opens the coil for that move.
  if(motion.laserLatched && motion.armed && !motion.busy()) motion.laser.set(true);
  releaseIdleRelay();

  job.tick(motion,millis());
  if(storedJob && !job.running()){
    storedJob=false;
    motion.leaseMs=HEARTBEAT_LEASE_MS; // arm timeout applies again only after the file ends
    motion.ping(millis());
  }
  if(usbPending && !motion.busy()){
    usbPending=false;
    Serial.print(job.running()?"ok\n":"error:aborted\n"); // reply for the finished (or stopped) move
  }
  webJobService();

  for(unsigned budget=0; budget<64 && Serial.available(); ++budget){
    char ch=(char)Serial.read();
    if(ch=='\r') continue;
    if(ch=='!'){ // real-time abort (GRBL style): no newline needed
      emergencyStop();
      used=0; discardLine=false;
      continue;
    }
    if(ch=='\t') ch=' ';
    if(ch=='\n'){
      if(discardLine){
        Serial.printf("error:%s\n",discardWhy); // the website always gets a reply
      } else if(used){
        inputLine[used]=0;
        if(isGcodeLine(inputLine)){
          usbGcode(inputLine);
        } else {
          bool wasBusy=motion.busy();
          handleLine(inputLine);
          if(!wasBusy && motion.busy()) webMotion=false; // started from USB: no phone dead-man
        }
      }
      used=0; discardLine=false;
    } else if(ch<32 || ch>126 || used>=sizeof(inputLine)-1){
      if(!discardLine){
        discardWhy=(ch<32 || ch>126)?"bad_char":"line_too_long";
        // Garbled bytes must not abort a file already stored, or an upload still in progress.
        if(!storedJob && !jobUpload){ motion.stop(Reason::BadCommand); status(lastSeq); }
      }
      discardLine=true; used=0;
    } else if(!discardLine){
      inputLine[used++]=ch;
    }
  }

  if((nowMs-lastStatusMs)>=200) status(lastSeq);
}