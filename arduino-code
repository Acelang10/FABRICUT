// Soft box is OFF until the website sends LIMIT. Saved in flash, so a reset
// or unplug restores the same box. X- and Y- are not blocked at 0 while off.
// Machine position is not saved: after a reset the pose reads 0,0 again.
bool softLimitOn=false;
float limX0=0, limX1=X_MAX_MM, limY0=0, limY1=Y_MAX_MM;
// Saved travel target. STARTPT moves here with the laser off. Kept across reset.
bool startOn=false;
float startX=0, startY=0;
const char* discardWhy="bad_char";

