# Local Next.js app. Copy to .env.local and fill in values. Do not commit secrets.

# Admin env login (httpOnly session cookie)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# SESSION_SECRET=

# Firestore shop store
# SHOP_STORE=firestore
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Low-stock alerts (server default is 5)
LOW_STOCK_THRESHOLD=5

# Email notifications are off until SMTP is configured.
# To turn them on, set EMAIL_NOTIFICATIONS=on and fill in SMTP details.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password>, EMAIL_FROM=you@gmail.com, ADMIN_NOTIFY_EMAIL=you@gmail.com
EMAIL_NOTIFICATIONS=off
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# Leave this empty for local development. Vite proxies /api to http://localhost:5001.
# Set this to the backend origin only when the frontend and API are deployed on different hosts.
VITE_API_URL=

# Local Controller (admin > Local Controller). Only works on this computer (localhost/127.0.0.1),
# never on Vercel. `npm run dev` enables it automatically; for `npm start` set LOCAL_CONTROLLER=on.
# LOCAL_CONTROLLER=off hides it everywhere.
LOCAL_CONTROLLER=
# ESP32 Wi-Fi controller address (private http address only). Join the Mac to Fabricut-Controller first.
ESP32_CONTROLLER_URL=http://192.168.4.1
