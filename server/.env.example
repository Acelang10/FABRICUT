# Paste the Firebase web app config here. Leave these blank until you have it.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
PORT=5001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Public backend origin used by separately hosted frontends, if needed.
PUBLIC_URL=

# Empty means no account can access business data. Explicitly approved emails only.
FIREBASE_STAFF_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000
HOST=127.0.0.1

# Bootstrap owners only, not a restriction on Google sign-in. Other staff require UID approvals.
FIREBASE_OWNER_EMAILS=
